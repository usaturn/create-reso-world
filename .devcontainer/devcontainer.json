// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
	"name": "create-reso-world",
	"mounts": [
		"source=${localEnv:HOME}/.codex,target=/home/vscode/.codex,type=bind,consistency=cached",
		"source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
		"source=${localEnv:HOME}/.claude.json,target=/home/vscode/.claude.json,type=bind,consistency=cached",
		"source=${localEnv:HOME}/.grok,target=/home/vscode/.grok,type=bind,consistency=cached",
		"source=${localEnv:HOME}/.pi,target=/home/vscode/.pi,type=bind,consistency=cached",
		"source=${localEnv:HOME}/.local/share/devin,target=/home/vscode/.local/share/devin,type=bind,consistency=cached",
		"source=${localEnv:HOME}/.config/devin,target=/home/vscode/.config/devin,type=bind,consistency=cached",
		"source=${localEnv:HOME}/.local/share/cursor-agent,target=/home/vscode/.local/share/cursor-agent,type=bind,consistency=cached",
		"source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind,consistency=cached",
		"source=${localEnv:HOME}/.cursor,target=/home/vscode/.cursor,type=bind,consistency=cached",
		"source=${localEnv:HOME}/.config/glab-cli,target=/home/vscode/.config/glab-cli,type=bind,consistency=cached",
		"source=${localEnv:HOME}/.config/gcloud,target=/home/vscode/.config/gcloud,type=bind,consistency=cached",
		// 秘密情報（API トークンなど）。zshrc.txt が env を存在時だけ読み込む
		"source=${localEnv:HOME}/.config/create-reso-world,target=/home/vscode/.config/create-reso-world,type=bind,consistency=cached"
	],
    // 既定の loginInteractiveShell は ~/.zshrc を読むため herdrstart が走り、
    // herdr を起動したままハングする。残留シェルが herdr サーバを
    // ホームで起動すると session.json の cwd が汚染される。
    // zsh -l（非対話）は ~/.zshrc を読まないため、この経路を断てる。
    "userEnvProbe": "loginShell",
    "containerEnv": {
        "SHELL": "/usr/bin/zsh"
    },
    "remoteEnv": {
        // ユーザ単位で導入するツール（claude・uv など、herdr の補助スクリプト、dotnet tool）。mounts と同じく
        // /home/vscode を直接書く
        "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin:/home/vscode/bin:/home/vscode/.dotnet/tools"
    },
	"initializeCommand": "/bin/bash .devcontainer/initialize.bash",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu26.04",
	"runArgs": [
		// Required for Codex CLI's Linux sandbox (bubblewrap/user namespaces) in devcontainer/WSL2.
		"--cap-add=SYS_ADMIN",
		"--security-opt",
		"seccomp=unconfined",
		"--security-opt",
		"apparmor=unconfined",
		"--network=host"
	],
  "features": {
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/devcontainers/features/dotnet:2": {
			"version": "10.0",
			// resoloop fork の global.json が要求する SDK。.devcontainer/resoloop.lock の RESOLOOP_FORK_SDK と揃える
			"additionalVersions": "10.0.201"
		},
		"ghcr.io/devcontainers/features/node:2": {
		"nodeGypDependencies": true,
		// リポジトリのタスク・CLI 導入は npm に一本化した。yarn を apt 経由で
		// 常駐インストールする必要はなく、既定 (false) の corepack 経由に戻す。
		"installYarnUsingApt": false,
		"version": "24",
		// pnpm を使うツールは無いため導入しない（省略すると latest が入る）。
		"pnpmVersion": "none",
		"nvmVersion": "latest"
		}
	},

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],
	"forwardPorts": [8000],

	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "uname -a",
	"postCreateCommand": "/bin/bash .devcontainer/install_beforehand.bash",

	// Configure tool-specific properties.
	// "customizations": {},
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "zsh",
                    "terminal.integrated.profiles.linux": {
                        "zsh": {
                        "path": "/usr/bin/zsh",
                        "args": ["-l"]
                    }
                }
            }
        }
    }
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
