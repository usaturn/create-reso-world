#!/usr/bin/env zsh

set -euo pipefail

#
# pi-superagents のランチャー別設定を適用する共通ヘルパ。
# install_beforehand.bash は本体と一緒に ~/.local/bin へ配置する。
# リポジトリから直接実行する場合は .devcontainer/ 側を使う。
#
typeset -a PI_SUPERAGENTS_HELPER_CANDIDATES=(
    "${0:A:h}/pi-superagents-exec.zsh"
    "${HOME}/.local/bin/pi-superagents-exec.zsh"
)
typeset PI_SUPERAGENTS_HELPER=""
for _candidate in "${PI_SUPERAGENTS_HELPER_CANDIDATES[@]}"; do
    if [[ -f "${_candidate}" ]]; then
        PI_SUPERAGENTS_HELPER="${_candidate}"
        break
    fi
done
unset _candidate
if [[ -z "${PI_SUPERAGENTS_HELPER}" ]]; then
    print -ru2 -- "[${0:t}] ERROR: pi-superagents-exec.zsh が見つかりません。"
    print -ru2 -- ""
    print -ru2 -- "リポジトリのルートで setup スクリプトを一度実行してください:"
    print -ru2 -- ""
    print -ru2 -- "  zsh .devcontainer/setup_pi_superagents.zsh"
    exit 1
fi
source "${PI_SUPERAGENTS_HELPER}"

readonly PI_DIR="${PI_CODING_AGENT_DIR:-${HOME}/.pi/agent}"
readonly MODELS_JSON="${PI_DIR}/models.json"
readonly PROVIDER="opencode-go"
readonly MODEL="union-alpha"

#
# Compatibility with the environment variable used by an older setup.
#
if [[ -z "${OPENCODE_API_KEY:-}" && -n "${OPENCODE_GO_API_KEY:-}" ]]; then
    export OPENCODE_API_KEY="${OPENCODE_GO_API_KEY}"
fi

#
# 既定モデルは opencode-go の union-alpha（表示名 "Union Alpha Free"）。
# 期間限定で無料提供されるステルスモデルで、context window は 262,144、
# max output は 131,072、画像入力に対応する。
#
# union-alpha は pi のモデルカタログに無いため、定義は pi-models.json 側に
# ある（pigo と同じ形）。カタログに無い ID を渡すと pi は警告を出したうえで
# opencode-go の既定モデルの定義を複製して使うため、ID は pi-models.json の
# 値に合わせること。setup スクリプトの手順 6 が各ランチャーの ID を検証する。
#
# このモデルは openai-completions / openai-responses では 500 を返し、
# anthropic-messages（https://opencode.ai/zen/go/v1/messages）だけで応答する。
# そのため定義の api は "anthropic-messages"、baseUrl は /v1 を付けない
# "https://opencode.ai/zen/go" である（Anthropic SDK が /v1/messages を補う）。
# エンドポイントは x-opencode-session ヘッダを必須とするが、pi は provider が
# opencode-go のモデルへ自動で付与するため、ランチャー側での対応は不要。
#
# thinking パラメータは受理されるが reasoning ブロックは返らない
# （reasoning: false）。--thinking max は他ランチャーとの統一のため残して
# おり、実装上は送られない。
#
# union-alpha の定義は pi-models.json にしか無い。
# install_beforehand.bash は models.json を「無い場合のみ」配置する一方、
# このランチャは毎回上書きで配置される。そのため既存の models.json を持つ
# 環境では union-alpha が未定義のままになり、pi は警告を出したうえで
# opencode-go の既定モデルの定義を複製して起動する。複製される定義は
# openai-* 系 api を持つため、このモデルへのリクエストは 500 で失敗する。
# piccd と同じく、起動前に models.json 側の定義を確認して setup を案内する。
#
# 判定できないとき（python3 が無い、models.json が読めない・壊れている）は
# チェックをスキップして pi に委ねる。ランチャが余計に起動を妨げないため。
#
if command -v python3 >/dev/null 2>&1 && [[ -f "${MODELS_JSON}" ]]; then
    if ! check="$(python3 - "${MODELS_JSON}" "${PROVIDER}" "${MODEL}" <<'PY'
import json
import sys

try:
    data = json.loads(open(sys.argv[1]).read())
except Exception:
    print("ok")
    sys.exit(0)

if not isinstance(data, dict):
    print("ok")
    sys.exit(0)

providers = data.get("providers")
# providers 自体が無ければ union-alpha は確実に未定義。piccd とは異なり
# ここはスキップせず、プロバイダ未定義として setup を案内する。
if not isinstance(providers, dict):
    print("no-provider")
    sys.exit(0)

provider = providers.get(sys.argv[2])
if not isinstance(provider, dict):
    print("no-provider")
    sys.exit(0)

models = provider.get("models")
if not isinstance(models, list):
    print("no-model")
    sys.exit(0)

ids = [entry.get("id") for entry in models if isinstance(entry, dict)]

print("ok" if sys.argv[3] in ids else "no-model")
PY
)"
    then
        check="ok"
    fi

    case "${check}" in
        ok)
            ;;
        no-provider)
            print -ru2 -- "[pigou] ERROR: provider \"${PROVIDER}\" is not defined in"
            print -ru2 -- "  ${MODELS_JSON}"
            print -ru2 -- ""
            print -ru2 -- "リポジトリのルートで setup スクリプトを一度実行してください:"
            print -ru2 -- ""
            print -ru2 -- "  zsh .devcontainer/setup_pi_opencode_go.zsh"
            exit 1
            ;;
        no-model)
            print -ru2 -- "[pigou] ERROR: model \"${MODEL}\" is not defined in"
            print -ru2 -- "  ${MODELS_JSON}"
            print -ru2 -- ""
            print -ru2 -- "provider \"${PROVIDER}\" の定義が古い可能性があります。"
            print -ru2 -- "リポジトリのルートで setup スクリプトを一度実行してください:"
            print -ru2 -- ""
            print -ru2 -- "  zsh .devcontainer/setup_pi_opencode_go.zsh"
            exit 1
            ;;
        *)
            #
            # 想定外の出力。判断できないのでチェックせず pi に委ねる。
            #
            ;;
    esac
fi

pi_superagents_exec pigou \
    --provider opencode-go \
    --model union-alpha \
    --thinking max \
    "$@" || exit 1
